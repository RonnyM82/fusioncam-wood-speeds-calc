{
  "name": "wood-speeds-feeds-calc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\" --allow-empty-input",
    "test": "node tests/run.js",
    "conformance": "python conformance.py .",
    "paint": "node tools/paint.mjs",
    "check:site": "npm run conformance && npm run test && npm run lint && npm run typecheck && npm run build",
    "check": "npm run check:site && npm run paint",
    "prepare": "node tools/install-hooks.mjs"
  },
  "dependencies": {
    "@livetools/ui": "0.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "10.11.0",
    "stylelint": "17.15.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0"
  }
}
